diff --git a/easytier/src/common/config.rs b/easytier/src/common/config.rs
index f92a310..2914373 100644
--- a/easytier/src/common/config.rs
+++ b/easytier/src/common/config.rs
@@ -602,10 +602,30 @@ impl TomlConfigLoader {
         };
 
         let old_ns = config.get_network_identity();
-        config.set_network_identity(NetworkIdentity::new(
-            old_ns.network_name,
-            old_ns.network_secret.unwrap_or_default(),
-        ));
+        // easytier-ios-build patch (credential-toml): a TOML config without
+        // network_secret but with secure_mode + local_private_key is a
+        // credential node, as with `easytier-core --credential`. Upstream
+        // v2.6.4 always derived an identity from the empty secret here, so
+        // credential nodes could only be started from the command line.
+        let secure_mode = config.get_secure_mode();
+        let credential_node = old_ns.network_secret.is_none()
+            && secure_mode
+                .as_ref()
+                .is_some_and(|c| c.enabled && c.local_private_key.is_some());
+        if let Some(c) = secure_mode
+            && c.enabled
+        {
+            // Fill in a missing key pair / public key, as the CLI does for --secure-mode / --credential.
+            config.set_secure_mode(Some(process_secure_mode_cfg(c)?));
+        }
+        if credential_node {
+            config.set_network_identity(NetworkIdentity::new_credential(old_ns.network_name));
+        } else {
+            config.set_network_identity(NetworkIdentity::new(
+                old_ns.network_name,
+                old_ns.network_secret.unwrap_or_default(),
+            ));
+        }
 
         Ok(config)
     }
