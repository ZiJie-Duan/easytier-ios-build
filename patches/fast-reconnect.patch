+/// # Safety
+/// Trinity: close every direct connection of the instance and dial again at once, keeping its
+/// peer id (a restart picks a new one). Returns 0, or -1 with `get_error_msg`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn reconnect_network_instance(
+    inst_name: *const std::ffi::c_char,
+) -> std::ffi::c_int {
+    let inst_name = unsafe {
+        assert!(!inst_name.is_null());
+        std::ffi::CStr::from_ptr(inst_name)
+            .to_string_lossy()
+            .into_owned()
+    };
+    let Some(inst_id) = INSTANCE_NAME_ID_MAP.get(&inst_name).map(|id| *id) else {
+        set_error_msg("instance not found");
+        return -1;
+    };
+    match INSTANCE_MANAGER.reconnect_network_instance(&inst_id) {
+        Ok(()) => 0,
+        Err(e) => {
+            set_error_msg(&format!("failed to reconnect: {}", e));
+            -1
+        }
+    }
+}
+
